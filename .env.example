# GEMINI_API_KEY: Required for server-side Gemini AI endpoints (/api/ai/*).
# Configure in Secrets (AI Studio) or environment variables (Cloud Run / Docker / VPS).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT & NODE_ENV: Server runtime settings
PORT="3000"
NODE_ENV="production"

# APP_URL: Public HTTPS origin where this app is hosted
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated extra CORS origins allowed for /api/* and /ws
# (e.g. https://starripple-im.yourname.workers.dev,https://chat.example.com)
ALLOWED_ORIGINS=""

# FIREBASE_PROJECT_ID: Optional override for server-side Firebase ID Token audience/issuer verification
FIREBASE_PROJECT_ID="ai-studio-applet-webapp-9b00f"

# VITE_SERVER_URL: Optional build-time server origin baked into standalone Electron / Capacitor packages
# Example: https://chat.example.com
VITE_SERVER_URL=""
