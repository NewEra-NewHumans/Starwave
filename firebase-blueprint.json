{
  "entities": {
    "User": {
      "title": "User",
      "description": "Verified StarRipple user profile containing private email binding and immutable 9-digit exclusive accountId.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "description": "Verified Google or Microsoft email address (PII)."
        },
        "emailProvider": {
          "type": "string",
          "enum": ["google", "microsoft"],
          "description": "Identity provider category for email verification."
        },
        "accountId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[1-9][0-9]{8}$",
          "description": "Exclusive 9-digit StarRipple Account ID allocated at registration."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Display nickname."
        },
        "avatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar asset key or HTTPS URL."
        },
        "signature": {
          "type": "string",
          "maxLength": 160,
          "description": "Personal status signature."
        },
        "level": {
          "type": "integer",
          "description": "Current growth tier level."
        },
        "activeDays": {
          "type": "integer",
          "description": "Cumulative active days."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "emailProvider",
        "accountId",
        "name",
        "avatar",
        "signature",
        "level",
        "activeDays",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccountIndex": {
      "title": "AccountIndex",
      "description": "Zero-PII directory record keyed by 9-digit exclusive accountId so authenticated users can search and add friends by ID.",
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[1-9][0-9]{8}$",
          "description": "Exclusive 9-digit StarRipple Account ID."
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Public display nickname."
        },
        "avatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar asset key or URL."
        },
        "signature": {
          "type": "string",
          "maxLength": 160,
          "description": "Public status signature."
        },
        "emailProvider": {
          "type": "string",
          "enum": ["google", "microsoft"],
          "description": "Provider badge without exposing email PII."
        },
        "level": {
          "type": "integer",
          "description": "Current growth tier level."
        },
        "online": {
          "type": "boolean",
          "description": "Online presence flag."
        },
        "platform": {
          "type": "string",
          "enum": ["Windows", "macOS", "iOS", "Android", "iPadOS", "Web"],
          "description": "Current active platform."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "accountId",
        "uid",
        "name",
        "avatar",
        "signature",
        "emailProvider",
        "level",
        "online",
        "platform",
        "createdAt",
        "updatedAt"
      ]
    },
    "Friend": {
      "title": "Friend",
      "description": "Persisted friend entry added by exclusive accountId under a user's private friends subcollection.",
      "type": "object",
      "properties": {
        "friendId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Friend document ID."
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID for strict query enforcement."
        },
        "accountId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[1-9][0-9]{8}$",
          "description": "Friend's exclusive 9-digit StarRipple Account ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Friend's display nickname."
        },
        "remark": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional alias/remark."
        },
        "avatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Friend avatar key or URL."
        },
        "signature": {
          "type": "string",
          "maxLength": 160,
          "description": "Friend signature."
        },
        "groupName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Contact folder group name."
        },
        "starred": {
          "type": "boolean",
          "description": "Whether friend is marked as special care."
        },
        "sparkDays": {
          "type": "integer",
          "description": "Interaction streak days."
        },
        "online": {
          "type": "boolean",
          "description": "Friend online state."
        },
        "platform": {
          "type": "string",
          "enum": ["Windows", "macOS", "iOS", "Android", "iPadOS", "Web"],
          "description": "Friend active platform."
        },
        "level": {
          "type": "integer",
          "description": "Friend growth level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "friendId",
        "uid",
        "accountId",
        "name",
        "remark",
        "avatar",
        "signature",
        "groupName",
        "starred",
        "sparkDays",
        "online",
        "platform",
        "level",
        "createdAt",
        "updatedAt"
      ]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Mutual friend verification request between two verified users keyed by fromUid_toUid.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic ID fromUid_toUid."
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender Firebase Auth UID."
        },
        "fromAccountId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[1-9][0-9]{8}$",
          "description": "Sender 9-digit StarRipple Account ID."
        },
        "fromName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Sender display name."
        },
        "fromAvatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Sender avatar key or URL."
        },
        "fromSignature": {
          "type": "string",
          "maxLength": 160,
          "description": "Sender signature."
        },
        "fromLevel": {
          "type": "integer",
          "description": "Sender growth level."
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Recipient Firebase Auth UID."
        },
        "toAccountId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[1-9][0-9]{8}$",
          "description": "Recipient 9-digit StarRipple Account ID."
        },
        "toName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Recipient display name."
        },
        "toAvatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Recipient avatar key or URL."
        },
        "note": {
          "type": "string",
          "maxLength": 120,
          "description": "Verification greeting message."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected"],
          "description": "Friend request workflow state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "requestId",
        "fromUid",
        "fromAccountId",
        "fromName",
        "fromAvatar",
        "fromSignature",
        "fromLevel",
        "toUid",
        "toAccountId",
        "toName",
        "toAvatar",
        "note",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudChat": {
      "title": "CloudChat",
      "description": "Shared direct or multi-user group chat metadata persisted in Firestore.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Chat document ID (dm_uidA_uidB or grp_...)."
        },
        "kind": {
          "type": "string",
          "enum": ["single", "group"],
          "description": "Direct message or multi-user group chat."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Group name or fallback direct chat label."
        },
        "avatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Group avatar key or URL."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Creator Firebase Auth UID."
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded participant UID list (1 to 50 members)."
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 200,
          "description": "Latest message summary text."
        },
        "lastMessageTime": {
          "type": "string",
          "maxLength": 20,
          "description": "Latest message HH:mm label."
        },
        "lastMessageSenderUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Sender UID of the latest message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "chatId",
        "kind",
        "title",
        "avatar",
        "ownerUid",
        "memberUids",
        "lastMessagePreview",
        "lastMessageTime",
        "lastMessageSenderUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudChatMessage": {
      "title": "CloudChatMessage",
      "description": "Persisted message entry inside a shared CloudChat messages subcollection.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Message document ID."
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent CloudChat ID."
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender Firebase Auth UID."
        },
        "senderAccountId": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[1-9][0-9]{8}$",
          "description": "Sender 9-digit StarRipple Account ID."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Sender display nickname."
        },
        "senderAvatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Sender avatar key or URL."
        },
        "type": {
          "type": "string",
          "enum": ["text", "image", "file", "voice", "system", "red_packet"],
          "description": "Message payload type."
        },
        "content": {
          "type": "string",
          "maxLength": 4000,
          "description": "Message text or description."
        },
        "timestampLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Formatted HH:mm display time."
        },
        "recalled": {
          "type": "boolean",
          "description": "Whether the sender recalled this message."
        },
        "burnAfterSeconds": {
          "type": "integer",
          "description": "Ephemeral burn timer in seconds (0 if disabled)."
        },
        "replyToSender": {
          "type": "string",
          "maxLength": 40,
          "description": "Quoted message sender name."
        },
        "replyToPreview": {
          "type": "string",
          "maxLength": 120,
          "description": "Quoted message preview."
        },
        "fileName": {
          "type": "string",
          "maxLength": 200,
          "description": "Attachment filename if file message."
        },
        "fileSizeBytes": {
          "type": "integer",
          "description": "Attachment file size in bytes."
        },
        "fileType": {
          "type": "string",
          "maxLength": 40,
          "description": "Attachment category tag."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 250000,
          "description": "Compressed image data URL or HTTPS image URL."
        },
        "memberUids": {
          "type": "array",
          "description": "Parent chat memberUids snapshot for query-enforced list rules."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-update timestamp."
        }
      },
      "required": [
        "messageId",
        "chatId",
        "senderUid",
        "senderAccountId",
        "senderName",
        "senderAvatar",
        "type",
        "content",
        "timestampLabel",
        "recalled",
        "burnAfterSeconds",
        "replyToSender",
        "replyToPreview",
        "fileName",
        "fileSizeBytes",
        "fileType",
        "imageUrl",
        "memberUids",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Owner-only user profile document storing verified Google/Microsoft email and immutable exclusive accountId."
    },
    "/account_ids/{accountId}": {
      "schema": {
        "$ref": "#/entities/AccountIndex"
      },
      "description": "Zero-PII lookup index keyed by 9-digit exclusive accountId for single-doc friend lookup without list scraping."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": {
        "$ref": "#/entities/Friend"
      },
      "description": "Owner-private subcollection storing friends added via exclusive accountId or accepted friend request."
    },
    "/friend_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/FriendRequest"
      },
      "description": "Mutual friend verification requests keyed deterministically by fromUid_toUid."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/CloudChat"
      },
      "description": "Shared direct and multi-user group chats accessible strictly to members in memberUids."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/CloudChatMessage"
      },
      "description": "Persisted messages inside a shared cloud chat."
    }
  }
}
